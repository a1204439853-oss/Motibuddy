{
  "name": "motibuddy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "agent:desktop": "node scripts/start-agent-desktop.mjs",
    "agent:server": "node --env-file=server/.env.local server/index.mjs",
    "agent:verify-live": "node --env-file=server/.env.local scripts/verify-agent-live.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib",
    "check:desktop": "npm run check && npm run test:rust && cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "dev:client": "vite --host --port 3000",
    "dev": "vite --host --port 3000",
    "build:client": "npm run build",
    "build": "npm run check && vite build",
    "build:desktop": "npm run check:desktop && vite build",
    "build:widget": "npm run check && vite build --config vite.widget.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "clsx": "^2.1.1",
    "compromise": "^14.14.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "recharts": "^2.15.1",
    "sonner": "^2.0.2",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
